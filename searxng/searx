#!/usr/bin/env python3
"""Search a SearXNG instance for links.

Exit codes: 0 results, 1 empty results, 2 usage, 3 unreachable instance.
Set SEARXNG_URL to choose an instance; the default uses loopback.
"""
import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "http://127.0.0.1:8888"


def clean_text(value) -> str:
    return re.sub(r"[\x00-\x1f\x7f-\x9f]", "", str(value))


def main() -> int:
    p = argparse.ArgumentParser(prog="searx", description=__doc__.splitlines()[0])
    p.add_argument("query")
    p.add_argument("-n", "--max-results", type=int, default=10)
    p.add_argument("--engines", help="comma-separated engine names")
    p.add_argument("--categories", help="comma-separated, e.g. general,news,it")
    p.add_argument("--time", choices=["day", "week", "month", "year"])
    p.add_argument("--lang", default="auto")
    p.add_argument("--page", type=int, default=1)
    p.add_argument("--json", action="store_true", help="print the raw response")
    p.add_argument("--timeout", type=float, default=20.0)
    a = p.parse_args()

    params = {"q": a.query, "format": "json", "language": a.lang, "pageno": a.page}
    if a.engines:
        params["engines"] = a.engines
    if a.categories:
        params["categories"] = a.categories
    if a.time:
        params["time_range"] = a.time

    base = os.environ.get("SEARXNG_URL", DEFAULT_URL).rstrip("/")
    url = f"{base}/search?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": "searx-cli/1"})
    try:
        with urllib.request.urlopen(req, timeout=a.timeout) as r:
            data = json.load(r)
        if (not isinstance(data, dict)
                or not isinstance(data.get("results"), list)
                or not all(isinstance(result, dict) for result in data["results"])):
            raise ValueError("expected an object with a list of object results")
    except (urllib.error.URLError, TimeoutError, ValueError) as e:
        print(f"searx: {base} unreachable or bad response: {e}", file=sys.stderr)
        return 3

    results = data.get("results", [])[: a.max_results]
    if a.json:
        data["results"] = results
        json.dump(data, sys.stdout, indent=2)
        print()
    else:
        for i, r in enumerate(results, 1):
            engines = ",".join(clean_text(eng) for eng in r.get("engines", []))
            print(f"{i}. {clean_text(r.get('title', '')).strip()}\n   {clean_text(r.get('url'))}\n   [{engines}] {clean_text(r.get('publishedDate') or '')}".rstrip())
        for eng, why in data.get("unresponsive_engines", []):
            print(f"unresponsive: {clean_text(eng)} ({clean_text(why)})", file=sys.stderr)
    return 0 if results else 1


if __name__ == "__main__":
    sys.exit(main())
